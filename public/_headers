/kartalempire/latest*.json
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# Jeu RL2 : scripts, styles et moteur ne se gardent pas en cache. Sans ca,
# le navigateur gardait 4 h d'anciens scripts face a une page neuve, et le
# jeu ne demarrait plus. Un simple `no-cache` ne suffit pas : le reglage
# « Browser Cache TTL » de Cloudflare le remplace par 4 h ; `no-store`, lui,
# est respecte (comme pour kartalempire ci-dessus).
/rl2/js/*
  Cache-Control: no-cache, no-store, must-revalidate
/rl2/assets/*.css
  Cache-Control: no-cache, no-store, must-revalidate
/rl2/assets/rl2.wasm
  Cache-Control: no-cache, no-store, must-revalidate
