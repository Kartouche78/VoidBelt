{
  "name": "voidbelt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "cargo run",
    "dev": "cargo run",
    "build:rl2": "powershell -ExecutionPolicy Bypass -File voidbelt-rl2/build.ps1",
    "test:rl2": "cargo test --manifest-path voidbelt-rl2/Cargo.toml --release",
    "share": "bash partager.sh",
    "test:ui": "node public/rl2/js/panneau.test.mjs",
    "test:page": "node public/rl2/js/page.test.mjs",
    "test": "npm run test:rl2 && npm run test:ui && npm run test:page"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
